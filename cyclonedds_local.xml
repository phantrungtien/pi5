<?xml version="1.0" encoding="UTF-8"?>
<!-- DDS chi noi bo Jetson (lo), dung khi tailscale0 chua co IP sau 60 s luc boot - xem dds_env.sh.
     Giong cyclonedds_tailscale.xml, chi doi card mang + peer. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces><NetworkInterface name="lo"/></Interfaces>
      <AllowMulticast>false</AllowMulticast>
    </General>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>30</MaxAutoParticipantIndex>
      <Peers><Peer Address="127.0.0.1"/></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
